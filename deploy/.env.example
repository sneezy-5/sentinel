# Copy to deploy/.env and fill in real values. Never commit deploy/.env itself.

# DNS A record for this must point at the VPS running this stack - Caddy uses it to
# request a Let's Encrypt certificate automatically.
SENTINEL_DOMAIN=monitoring.example.com

# Any long random string works; this is the TimescaleDB password, not an agent token.
DB_PASSWORD=change-me

# Dashboard login, created once on first boot (see AdminSeeder) - change the password from
# the Settings page after logging in, these values are ignored after the account exists.
ADMIN_USERNAME=admin
ADMIN_PASSWORD=change-me
