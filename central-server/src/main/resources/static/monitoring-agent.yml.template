# Sentinel agent config. Generated by install.sh with centralUrl/token already filled in -
# everything else is optional (architecture doc, section 3.3, level 2): the agent runs
# fine even if you never touch the lines below token.

centralUrl: "__CENTRAL_URL__"
token: "__TOKEN__"

# Every value below this line has a reasonable default, uncomment to override.

# pushIntervalSeconds: 20

# Exclude services by exact name or pattern (filtering of known system processes - level 1
# - is already applied automatically, no need to repeat it here).
# excludeServices:
#   - "docker-proxy"

# includeServices:
#   - "djeli-api"
