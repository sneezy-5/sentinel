# Sentinel agent config. Generated by install.sh with centralUrl/token already filled in -
# everything else is optional (architecture doc, section 3.3, level 2): the agent runs
# fine even if you never touch the lines below token.

centralUrl: "__CENTRAL_URL__"
token: "__TOKEN__"

# Every value below this line has a reasonable default, uncomment to override.

# pushIntervalSeconds: 20

# Exclude services by exact name or pattern (filtering of known system processes - level 1
# - is already applied automatically, no need to repeat it here).
# excludeServices:
#   - "docker-proxy"

# includeServices:
#   - "djeli-api"

# Largest files under this path get reported/alertable as heaviestFileSizeMb - a full-disk
# scan every push cycle would be too expensive, so this only looks under one directory and
# only rescans every heaviestFileScanIntervalSeconds. Set heaviestFileScanPath to "" to
# disable entirely.
# heaviestFileScanPath: "/var/log"
# heaviestFileScanIntervalSeconds: 3600

# Only relevant if nginx is installed directly on this host (not in Docker - a dockerized
# nginx is already covered by the normal container log collection). Set either to "" to
# disable.
# nginxAccessLogPath: "/var/log/nginx/access.log"
# nginxErrorLogPath: "/var/log/nginx/error.log"
